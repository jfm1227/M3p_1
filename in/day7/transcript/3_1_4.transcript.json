      "compression_ratio": 10.741379310344827
    },
    {
      "audio": "3_1_4_16k.wav",
      "segment_id": 1,
      "start": 8.24,
      "end": 18.22,
      "text": "あ、でも向こうは全然気づいてないみたいで、 あっちには新しい友達がいて、みんなで楽しそうに笑われ、",
      "avg_logprob": -0.4223054211314132,
      "no_speech_prob": 0.8014479875564575,
      "temperature": 0.0,
      "compression_ratio": 1.228813559322034
    },
    {
      "audio": "3_1_4_16k.wav",
      "segment_id": 2,
      "start": 18.22,
      "end": 23.58,
      "text": "笑ってたんだよね 私がたなかって話しかきようとした",
      "avg_logprob": -0.06920142067803277,
      "no_speech_prob": 0.67032790184021,
      "temperature": 0.0,
      "compression_ratio": 6.435185185185185
    },
    {
      "audio": "3_1_4_16k.wav",
      "segment_id": 3,
      "start": 23.58,
      "end": 32.74,
      "text": "しんかんなんか声が出なくなっちゃって 昔はあんなに毎日一緒にいたのにもう私なんて",
      "avg_logprob": -0.18495327631632488,
      "no_speech_prob": 0.39001986384391785,
      "temperature": 0.0,
      "compression_ratio": 5.6434108527131785
    },
    {
      "audio": "3_1_4_16k.wav",
      "segment_id": 4,
      "start": 32.74,
      "end": 33.56,
      "text": "忘れられちゃれちゃって 昔はあんなに毎日一緒にいたのにもう私なんて忘れられちゃって",
      "avg_logprob": -0.18495327631632488,
      "no_speech_prob": 0.39001986384391785,
      "temperature": 0.0,
      "compression_ratio": 5.6434108527131785
    },
    {
      "audio": "3_1_4_16k.wav",
      "segment_id": 5,
      "start": 33.56,
      "end": 37.38,
      "text": "だったのかなーって思ったらすごく悲しくなっちゃってさ",
      "avg_logprob": -0.34461168501112194,
      "no_speech_prob": 0.9088557958602905,
      "temperature": 0.0,
      "compression_ratio": 13.846153846153847
