    {
      "audio": "3_1_3_16k.wav",
      "segment_id": 1,
      "start": 4.94,
      "end": 10.59,
      "text": "聞かせてくれてありがとう クッキーの写真もちろんいつでも見せるよ",
      "avg_logprob": -0.05476040257347955,
      "no_speech_prob": 0.8765387535095215,
      "temperature": 0.0,
