      "temperature": 0.0,
      "compression_ratio": 1.076271186440678
    },
    {
      "audio": "1_0_2_16k.wav",
      "segment_id": 3,
      "start": 20.35,
      "end": 26.99,
      "text": "そしてついに黒はボロボロのボールに材料を入れ混ぜ始めました",
      "avg_logprob": -0.05514751275380452,
      "no_speech_prob": 0.4895024001598358,
      "temperature": 0.0,
      "compression_ratio": 4.96875
    },
    {
      "audio": "1_0_2_16k.wav",
      "segment_id": 4,
      "start": 28.0,
      "end": 36.56,
      "text": "ザクザクザクザクザククッキーの生地をこねていると甘い匂いがだんだんと漂ってきました",
      "avg_logprob": -0.15205925835503473,
