    {
      "audio": "3_1_3_16k.wav",
      "segment_id": 4,
      "start": 25.72,
      "end": 29.06,
      "text": "ようになるって聞いたことがあるんだ だからだからだからだからだから",
      "avg_logprob": -0.30872402191162107,
      "no_speech_prob": 0.9081287980079651,
      "temperature": 0.0,
      "compression_ratio": 13.212121212121213
    },
    {
      "audio": "3_1_3_16k.wav",
      "segment_id": 5,
      "start": 29.52,
      "end": 36.34,
      "text": "クッキーも、三王の猫ちゃんも、私たちがこうやって話すたびに、きっと喜んでくれてるよね。",
      "avg_logprob": -0.12152673191494412,
      "no_speech_prob": 0.6776963472366333,
