      "temperature": 0.0,
      "compression_ratio": 1.2446808510638299
    },
    {
      "audio": "1_0_2_16k.wav",
      "segment_id": 2,
      "start": 10.53,
      "end": 18.73,
      "text": "小枝で加工を編み、丼を集め、 森のリスやウサギにも手伝ってもらい、材料を頂戴しました。",
      "avg_logprob": -0.42586665527493345,
